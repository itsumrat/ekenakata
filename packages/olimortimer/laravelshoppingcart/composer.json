{
    "name": "olimortimer/laravelshoppingcart",
    "description": "Laravel Shoppingcart",
    "keywords": [
        "laravel",
        "shoppingcart"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Rob Gloudemans",
            "email": "info@robgloudemans.nl"
        },
        {
            "name": "Michael V.",
            "email": "michael@michaelbelgium.me"
        },
        {
            "name": "Oli Mortimer",
            "email": "oli@olimortimer.com"
        }
    ],
    "require": {
        "illuminate/support": "^9|^10|^11|^12",
